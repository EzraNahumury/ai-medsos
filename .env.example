# =====================================================
# IG AI Command Center — Environment Configuration
# =====================================================
# Copy this file to .env and fill in the values below.

# ---------- Database (XAMPP MySQL) ----------
DATABASE_URL="mysql://root:@localhost:3306/ig_ai_command_center"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Admin Auth ----------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-long-random-string"

# ---------- Meta / Instagram OAuth ----------
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v25.0"
META_REDIRECT_URI="http://localhost:3000/api/instagram/oauth/callback"
META_OAUTH_SCOPES="instagram_business_basic,instagram_manage_comments,instagram_business_manage_messages"
META_WEBHOOK_VERIFY_TOKEN="replace-with-random-webhook-token"

# ---------- Token Encryption ----------
# AES-256-GCM key. Must be a base64 string that decodes to exactly 32 bytes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# ---------- Ollama (placeholder) ----------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# ---------- Development helpers ----------
# When "true", enables /api/instagram/dev/import-token and /api/instagram/dev/test-token.
# MUST be "false" in production.
DEV_ALLOW_MANUAL_TOKEN_IMPORT="true"
